DATABASE_URL=sqlite+aiosqlite:///./saas_agent.db
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=replace-with-a-deployment-secret
DEMO_MODE=false
# 本地测试可关闭；预生产和正式环境应保持 true。
REQUIRE_VERIFIED_EMAIL_FOR_COMPANY=false
AUTO_CREATE_SCHEMA=false
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
POSTGRES_USER=saas
SAAS_DB_PASSWORD=saas
APP_DB_USER=saas_app
SAAS_APP_DB_PASSWORD=change-this-app-password
POSTGRES_DB=saas_agent
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# New Runs only. Existing Runs retain their stored engine_version.
AGENT_ENGINE=legacy
EXECUTION_MODE=inline
AGENT_MAX_ROUNDS=20
AGENT_MAX_RETRIES=2
AGENT_MAX_REPLANS=2
AGENT_TOKEN_BUDGET=120000
AGENT_CONTEXT_TOKENS=12000
MODEL_MODE=deterministic
MODEL_BASE_URL=https://top.qingyuntop.ai/v1
MODEL_NAME=qwen-plus
MODEL_API_KEY=
MODEL_TIMEOUT=30
# OpenAI-compatible embeddings endpoint, hosted or private. Schema v2 is 512-D; migrate and rebuild before enabling real RAG.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=512
KNOWLEDGE_INDEX_VERSION=chunks-bge-cpu-v2
KNOWLEDGE_MIN_SIMILARITY=0.35
# Required in real mode; /rerank returns a full permutation.
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

# RAG rollout: keep mock until PostgreSQL, OpenSearch and real models are verified.
# PDF OCR is intentionally excluded from this release.
RAG_MODE=mock
MODEL_API_STYLE=chat_completions
LLM_MODE=online
LLM_LOCAL_MODEL=
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_REVISION=main
EMBEDDING_BATCH_SIZE=16
RERANKER_MODE=local
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_REVISION=main
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=256
OPENSEARCH_URL=
OPENSEARCH_INDEX=saas-rag-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# CPU BGE profile. FP32 baseline; calibrate before enabling quantization.
EMBEDDING_QUERY_STYLE=prefix
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
EMBEDDING_MAX_LENGTH=512
RETRIEVAL_CPU_THREADS=4
RERANKER_MAX_CANDIDATES=16
RERANKER_MAX_WINDOWS=32
KNOWLEDGE_CHUNK_TOKENS=220
KNOWLEDGE_CHUNK_OVERLAP=30
KNOWLEDGE_QUERY_EXPANSION=true

# Enable indexing for knowledge-base inspection.
RAG_V3_INDEXING_ENABLED=true
RAG_PDF_ENABLED=true
RAG_OFFICE_ENABLED=true
RAG_V3_RELEASE=evaluations/v3/release.json

# P0 context compression: start with shadow, switch to on after evaluation.
CHAT_CONTEXT_MODE=off
CHAT_CONTEXT_LOCAL_WORKER=false
CHAT_CONTEXT_TOKENS=20000
CHAT_SUMMARY_TOKENS=1200
MODEL_CONTEXT_WINDOW=32768
MODEL_MAX_OUTPUT_TOKENS=4096
CONTEXT_SAFETY_RATIO=0.1
# Set the actual generation-model tokenizer explicitly; no embedding tokenizer fallback.
# MODEL_TOKENIZER=tiktoken:o200k_base
# MODEL_TOKENIZER_MAP={"your-gateway-alias":"tiktoken:o200k_base"}
# Local tokenizer: MODEL_TOKENIZER=hf:C:/models/generation-model

# P1: enable after P0 acceptance and migration 0027.
CHAT_HISTORY_ENABLED=false
CHAT_MEMORY_ITEMS_ENABLED=false
# P2: candidates still require each user's explicit opt-in and confirmation.
CHAT_MEMORY_CANDIDATES_ENABLED=false
AGENT_EXPERIENCE_ENABLED=false
# Start with shadow, then use on only after evaluation.
CONTEXT_SCORING_MODE=off

# Docker backend build settings (timeout in seconds).
DOCKER_PIP_INDEX_URL=https://pypi.org/simple
DOCKER_PIP_TIMEOUT=120
DOCKER_PIP_RETRIES=10

# V3 rules use raw reranker scores; calibrated mode requires a verified release file.
RAG_V3_RELEVANCE_MODE=rules
RAG_V3_MIN_RERANK_SCORE=0.5
