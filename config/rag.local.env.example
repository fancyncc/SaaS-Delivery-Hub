# Local retrieval weights + online generation. Not a complete deployment file.
# Requires separately configured PostgreSQL and OpenSearch.
RAG_MODE=real
MODEL_MODE=real
LLM_MODE=online
MODEL_API_STYLE=chat_completions
MODEL_NAME=qwen-plus
MODEL_BASE_URL=https://top.qingyuntop.ai/v1
MODEL_API_KEY=
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_REVISION=main
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=16
RERANKER_MODE=local
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_REVISION=main
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=256
OPENSEARCH_URL=
OPENSEARCH_INDEX=saas-rag-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# CPU BGE profile. FP32 baseline; calibrate before enabling quantization.
EMBEDDING_QUERY_STYLE=prefix
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
EMBEDDING_MAX_LENGTH=512
RETRIEVAL_CPU_THREADS=4
RERANKER_MAX_CANDIDATES=16
RERANKER_MAX_WINDOWS=32
KNOWLEDGE_CHUNK_TOKENS=220
KNOWLEDGE_CHUNK_OVERLAP=30
KNOWLEDGE_QUERY_EXPANSION=true
